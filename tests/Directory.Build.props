<Project>

  <!-- Inherit repository-wide settings, then relax rules that do not suit test code. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Documentation generation stays on so IDE0005 (unnecessary usings) is checked in tests too; the comments themselves are not required. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591: missing XML comment; tests do not need API documentation.
      CA1707: underscores in test names are the xunit convention (Does_x_when_y).
      CA1416: Unix-only file-mode tests are guarded by NonRootFact, which skips on Windows.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1416</NoWarn>
  </PropertyGroup>

</Project>
